{
  "name": "foxsmusic-desktop",
  "version": "1.3.18",
  "description": "FoxsMusic Player Pro — F11 native fullscreen shortcut",
  "main": "main.cjs",
  "author": "ArtyomRedDarkFox",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis portable",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:all": "electron-builder --win nsis portable --linux AppImage deb",
    "test:hotkeys": "node tests/hotkeys-smoke.test.cjs",
    "test:now-playing": "node tests/now-playing-button.test.cjs",
    "test:repeat": "node tests/repeat-mode.test.cjs",
    "test:shuffle-stop": "node tests/shuffle-stop.test.cjs",
    "test": "npm run test:shuffle-stop && npm run test:repeat && npm run test:hotkeys && npm run test:now-playing"
  },
  "dependencies": {
    "music-metadata": "^12.3.2",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "com.artyomreddarkfox.foxsmusic",
    "productName": "FoxsMusic",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "main.cjs",
      "assets/**/*",
      "README.md",
      "preload.cjs"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "FoxsMusic-${version}-Windows-Portable-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FoxsMusic",
      "artifactName": "FoxsMusic-${version}-Windows-Setup-${arch}.${ext}"
    },
    "linux": {
      "icon": "assets/icons",
      "category": "AudioVideo",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "FoxsMusic-${version}-Linux-${arch}.${ext}",
      "maintainer": "ArtyomRedDarkFox"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MrArtyomRedDarkFox",
        "repo": "FoxsMusic-Desktop",
        "releaseType": "release"
      }
    ]
  }
}
